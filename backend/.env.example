# Database connection string
DATABASE_URL=postgresql+asyncpg://tradewatch:tradewatch_secret@postgres:5432/tradewatch_db

# Telegram Alert Configuration (Optional, can also be configured via Frontend Settings UI)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Polling interval in seconds
DEFAULT_POLLING_INTERVAL_SEC=30
DEFAULT_ALERT_COOLDOWN_MIN=15
